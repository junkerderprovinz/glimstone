{
  "chart": {
    "$description": "Chart colours (rule 50), every one an OKLCH value written out, so a phone app and a design tool read the same numbers. The series come in a fixed order: the eight accent hues, alternating warm and cool, in one band of lightness per theme, 0.50 to 0.64 light and 0.68 to 0.80 dark, so no series outshines the others or the accent. Inside the band the steps keep any two apart for people with protanopia, deuteranopia or tritanopia, and each reaches 3:1 on a card and the page.",
    "$extensions": {
      "org.glimstone": {
        "selector": ":root,\n[data-theme]",
        "theme": true
      }
    },
