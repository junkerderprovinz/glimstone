{
  "direction": {
    "$description": "A tab change. The strip sets --tab-dir to 1 toward a later tab and -1 toward an earlier one; --tab-dir-sign flips the side under a right-to-left script.",
    "$extensions": {
      "org.glimstone": {
        "selector": ":root",
        "layer": "components",
        "modes": [
          {
            "name": "rtl",
            "selector": "[dir=\"rtl\"]",
            "layer": "components"
          }
        ]
      }
    },
    "tab-dir-sign": {
      "$value": 1,
      "$type": "number",
      "$extensions": {
        "org.glimstone": {
          "modes": {
            "rtl": -1
          }
        }
      }
    }
  }
}
