    "motion-slosh-dur": {
      "$value": "5s",
      "$type": "duration",
      "$description": "A fill level's slosh: one swing to each wall and back, how far the liquid tilts, how high a crest runs up the wall and the hump rises as multiples of their drawn height, how far a bar's end surges and leans, the time a bubble takes per unit of depth and how strongly it shows, and how far a popping bubble lifts above the surface, swells, rings, sprays its droplets and runs past a bar's end.",
      "$extensions": {
        "org.glimstone": {
          "modes": {
            "wild": "3.6s",
            "off": "60s",
            "storm": "2.6s"
          },
          "modeNotes": {
            "off": "Long rather than 0, and stopped outright after the slosh's rules."
