{
  "motion": {
    "$description": "The motion engine's numbers. Each intensity is a token set read by the same keyframes, so a level is a different number, never a different animation. The offered levels live inside no-preference, so a system that asked for less motion never evaluates their selectors and keeps the reduce block's values. Storm's numbers are the exception, below the gate.",
    "$extensions": {
      "org.glimstone": {
        "selector": ":root",
        "media": "(prefers-reduced-motion: no-preference)",
        "modes": [
          {
            "name": "rtl",
            "selector": ":root[dir=\"rtl\"]",
            "media": "(prefers-reduced-motion: no-preference)"
          },
          {
            "name": "wild",
            "selector": ":root[data-motion='wild']",
            "media": "(prefers-reduced-motion: no-preference)",
            "$description": "The fourth control point past 1 makes the curve spring, the same shape React Native's spring gives the phone."
          },
          {
            "name": "wild-rtl",
            "selector": ":root[data-motion='wild'][dir=\"rtl\"]",
            "media": "(prefers-reduced-motion: no-preference)"
          },
          {
            "name": "off",
            "selector": ":root[data-motion='off']",
            "media": "(prefers-reduced-motion: no-preference)"
          },
          {
            "name": "storm",
            "selector": ":root[data-motion='storm']",
            "$description": "Storm, the hidden fourth level: the same keyframes with a spring that swings further and settles later. No picker offers it; see \"A hidden fourth level\" in the design language. The phone matches it with `springDamping: 0.34` against wild's 0.68.\n\nIts numbers sit outside the no-preference gate. Storm is the one level that still animates under reduced motion, and the reduce block below restores its animations from these tokens, which it could not read inside the gate."
          },
          {
            "name": "storm-rtl",
            "selector": ":root[data-motion='storm'][dir=\"rtl\"]"
          }
        ]
      }
    },
    "motion-page-dur": {
      "$value": "140ms",
      "$type": "duration",
      "$extensions": {
        "org.glimstone": {
          "modes": {
            "wild": "420ms",
            "off": "0s",
            "storm": "760ms"
          }
        }
      }
    },
    "motion-toast-dur": {
      "$value": "120ms",
      "$type": "duration",
      "$extensions": {
        "org.glimstone": {
          "modes": {
            "wild": "300ms",
            "off": "0s",
            "storm": "420ms"
          }
        }
      }
    },
    "motion-pulse-dur": {
      "$value": "3.2s",
      "$type": "duration",
      "$extensions": {
        "org.glimstone": {
          "modes": {
            "wild": "2s",
            "off": "3.2s",
            "storm": "1.4s"
          },
          "modeNotes": {
            "off": "Declared so this level does not inherit the lively number, but never read: `.glim-live` means \"this is happening now\", so here it stops fully opaque instead (below)."
          }
        }
      }
    },
    "motion-fade-dur": {
      "$value": "70ms",
      "$type": "duration",
      "$extensions": {
        "org.glimstone": {
          "modes": {
            "wild": "140ms",
            "off": "0s",
            "storm": "200ms"
          }
