    },
    "motion-shake-dur": {
      "$value": "220ms",
      "$type": "duration",
      "$extensions": {
        "org.glimstone": {
          "modes": {
            "wild": "360ms",
            "off": "0s",
            "storm": "520ms"
          }
        }
      }
    },
    "motion-page-travel": {
      "$value": "6px",
      "$type": "dimension",
      "$description": "Distance and curve set the levels apart along with duration: 6px against wild's 18px, and an ease where wild springs. There is no scale (see the keyframe above).",
      "$extensions": {
        "org.glimstone": {
          "modes": {
            "wild": "18px",
            "off": "0px",
            "storm": "34px"
          }
        }
      }
    },
    "motion-page-ease": {
      "$value": "cubic-bezier(.2, .6, .2, 1)",
      "$type": "cubicBezier",
      "$extensions": {
        "org.glimstone": {
          "modes": {
            "wild": "cubic-bezier(.34, 1.56, .64, 1)",
            "off": "linear",
            "storm": "cubic-bezier(.22, 1.94, .45, 1)"
          },
          "modeNotes": {
            "storm": "Further past 1 than wild's curve and slower to settle. It carries the level with distance and curve, never a scale."
          }
        }
      }
    },
    "motion-toast-ease": {
      "$value": "cubic-bezier(.2, .6, .2, 1)",
      "$type": "cubicBezier",
      "$description": "The toast slides in from the screen edge, and a spring would carry it back past that edge, which reads as a glitch, so it keeps this ease at every level but storm.",
      "$extensions": {
        "org.glimstone": {
          "modes": {
            "off": "ease",
            "storm": "cubic-bezier(.22, 1.94, .45, 1)"
          },
          "modeNotes": {
            "storm": "The only level where the toast springs past the screen edge."
          }
        }
      }
    },
    "glim-toast-slide": {
      "$value": "12px",
      "$type": "dimension",
      "$description": "Every toast distance needs its RTL twin, since the keyframe cannot be mirrored by a class.",
      "$extensions": {
        "org.glimstone": {
          "modes": {
            "rtl": "-12px",
            "wild": "24px",
            "wild-rtl": "-24px",
            "off": "0px",
            "storm": "44px",
            "storm-rtl": "-44px"
          }
        }
      }
    },
