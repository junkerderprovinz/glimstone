{
  "space": {
    "$description": "The spacing scale. Every padding, margin and gap in the components reads one of these steps: 2px apart up to 16px, where a step still shows, then wider. A distance between two steps is the bug, not a reason for a fourteenth. Optical nudges of a pixel or two, and the sizes of things, stay lengths of their own.",
    "$extensions": {
      "org.glimstone": {
        "selector": ":root"
      }
    },
    "space-1": {
      "$value": "0.125rem",
      "$type": "dimension",
      "$extensions": {
        "org.glimstone": {
          "note": "2px"
        }
      }
    },
