{
  "name": "@glimstone/vue",
  "version": "4.4.1",
  "description": "GlimStone's components for Vue",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junkerderprovinz/glimstone.git",
    "directory": "packages/vue"
  },
  "homepage": "https://junkerderprovinz.github.io/glimstone/",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
