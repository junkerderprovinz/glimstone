    },
    "./Select": {
      "types": "./dist/entries/select.d.ts",
      "default": "./dist/Select.js"
    },
    "./Combobox": {
      "types": "./dist/entries/combobox.d.ts",
      "default": "./dist/Combobox.js"
    },
    "./Slider": {
      "types": "./dist/entries/slider.d.ts",
      "default": "./dist/Slider.js"
    },
    "./Collapsible": {
      "types": "./dist/entries/collapsible.d.ts",
      "default": "./dist/Collapsible.js"
    },
    "./Accordion": {
      "types": "./dist/entries/accordion.d.ts",
      "default": "./dist/Accordion.js"
    },
    "./Avatar": {
      "types": "./dist/entries/avatar.d.ts",
      "default": "./dist/Avatar.js"
    },
    "./Pagination": {
      "types": "./dist/entries/pagination.d.ts",
      "default": "./dist/Pagination.js"
    },
    "./PinInput": {
      "types": "./dist/entries/pininput.d.ts",
      "default": "./dist/PinInput.js"
    },
    "./TagsInput": {
      "types": "./dist/entries/tagsinput.d.ts",
      "default": "./dist/TagsInput.js"
    },
    "./Steps": {
      "types": "./dist/entries/steps.d.ts",
      "default": "./dist/Steps.js"
    },
    "./Splitter": {
      "types": "./dist/entries/splitter.d.ts",
      "default": "./dist/Splitter.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@glimstone/core": "4.4.1"
  },
  "peerDependencies": {
    "@zag-js/accordion": "^1.47.0",
    "@zag-js/avatar": "^1.47.0",
    "@zag-js/collapsible": "^1.47.0",
    "@zag-js/combobox": "^1.46.0",
    "@zag-js/menu": "^1.46.0",
    "@zag-js/pagination": "^1.47.0",
    "@zag-js/pin-input": "^1.47.0",
    "@zag-js/select": "^1.46.0",
    "@zag-js/slider": "^1.46.0",
    "@zag-js/splitter": "^1.47.0",
    "@zag-js/steps": "^1.47.0",
    "@zag-js/tags-input": "^1.47.0",
    "@zag-js/vue": "^1.46.0",
    "vue": "^3.5.0"
  }
