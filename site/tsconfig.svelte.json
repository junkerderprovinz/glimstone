{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "verbatimModuleSyntax": true,
    "paths": {
      "@glimstone/core/glyphs.json": ["../packages/core/glyphs.json"],
      "@glimstone/core": ["../packages/core/src/index.ts"],
      "@glimstone/svelte": ["../packages/svelte/src/index.ts"],
      "@glimstone/svelte/Select": ["../packages/svelte/src/entries/select.ts"],
      "@glimstone/svelte/Combobox": ["../packages/svelte/src/entries/combobox.ts"],
      "@glimstone/svelte/Slider": ["../packages/svelte/src/entries/slider.ts"]
