{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@glimstone/core/glyphs.json": ["../packages/core/glyphs.json"],
      "@glimstone/core": ["../packages/core/src/index.ts"],
      "@glimstone/core/*": ["../packages/core/src/*"],
      "@glimstone/react": ["../packages/react/src/index.ts"],
      "@glimstone/react/*": ["../packages/react/src/*"],
      "@glimstone/vue": ["../packages/vue/src/index.ts"],
      "@glimstone/vue/Select": ["../packages/vue/src/entries/select.ts"],
      "@glimstone/vue/Combobox": ["../packages/vue/src/entries/combobox.ts"],
      "@glimstone/vue/Slider": ["../packages/vue/src/entries/slider.ts"]
    }
  },
  "include": ["src", "tests", "test", "vite.config.ts", "playwright.config.ts"]
}
