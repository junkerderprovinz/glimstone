{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@glimstone/core/glyphs.json": ["../packages/core/glyphs.json"],
      "@glimstone/core": ["../packages/core/src/index.ts"],
      "@glimstone/core/*": ["../packages/core/src/*"],
      "@glimstone/react": ["../packages/react/src/index.ts"],
      "@glimstone/react/*": ["../packages/react/src/*"],
      "@glimstone/vue": ["../packages/vue/src/index.ts"],
      "@glimstone/vue/Select": ["../packages/vue/src/entries/select.ts"],
      "@glimstone/vue/Combobox": ["../packages/vue/src/entries/combobox.ts"],
      "@glimstone/vue/Slider": ["../packages/vue/src/entries/slider.ts"],
      "@glimstone/vue/Collapsible": ["../packages/vue/src/entries/collapsible.ts"],
      "@glimstone/vue/Accordion": ["../packages/vue/src/entries/accordion.ts"],
      "@glimstone/vue/Avatar": ["../packages/vue/src/entries/avatar.ts"],
      "@glimstone/vue/Pagination": ["../packages/vue/src/entries/pagination.ts"],
      "@glimstone/vue/PinInput": ["../packages/vue/src/entries/pininput.ts"],
      "@glimstone/vue/TagsInput": ["../packages/vue/src/entries/tagsinput.ts"],
      "@glimstone/vue/Steps": ["../packages/vue/src/entries/steps.ts"],
      "@glimstone/vue/Splitter": ["../packages/vue/src/entries/splitter.ts"],
      "@glimstone/vue/ScrollArea": ["../packages/vue/src/entries/scrollarea.ts"],
      "@glimstone/vue/FileUpload": ["../packages/vue/src/entries/fileupload.ts"],
      "@glimstone/vue/DatePicker": ["../packages/vue/src/entries/datepicker.ts"],
      "@glimstone/vue/Rating": ["../packages/vue/src/entries/rating.ts"],
      "@glimstone/vue/Timer": ["../packages/vue/src/entries/timer.ts"],
      "@glimstone/vue/AngleSlider": ["../packages/vue/src/entries/angleslider.ts"],
      "@glimstone/vue/SignaturePad": ["../packages/vue/src/entries/signaturepad.ts"],
      "@glimstone/vue/HoverCard": ["../packages/vue/src/entries/hovercard.ts"],
      "@glimstone/vue/Carousel": ["../packages/vue/src/entries/carousel.ts"],
      "@glimstone/vue/Marquee": ["../packages/vue/src/entries/marquee.ts"],
      "@glimstone/vue/Tour": ["../packages/vue/src/entries/tour.ts"],
      "@glimstone/vue/FloatingPanel": ["../packages/vue/src/entries/floatingpanel.ts"]
    }
  },
  "include": ["src", "tests", "test", "vite.config.ts", "playwright.config.ts"]
}
